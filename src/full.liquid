{% comment %}
  Alvey Command Center: calendar and daily Noblesville forecasts joined by local date.
  Weather: Open-Meteo (CC BY 4.0). Event and forecast values remain in TRMNL.
  WMO weather interpretation codes: https://open-meteo.com/en/docs
{% endcomment %}
{% comment %}CalendarMerge:setup:start{% endcomment %}
{% comment %}Calendar merge: conservative title/time/type/location matching; no private event fixtures.{% endcomment %}
{% assign stu_calendar = apple_calendar_535612 %}
{% assign ali_calendar = apple_calendar_536125 %}
{% assign stu_events = stu_calendar.events | default: empty | sort: 'start_full' %}
{% assign ali_events = ali_calendar.events | default: empty | sort: 'start_full' %}
{% assign events = stu_events | concat: ali_events | sort: 'start_full' %}
{% capture stu_keys %}{% for event in stu_events %}{% assign event_status = event.status | downcase %}{% unless event_status == 'cancelled' or event_status == 'canceled' %}{%- assign normalized_title = event.summary | strip | downcase -%}
{%- assign normalized_location = event.location | strip | downcase -%}
{%- if event.summary != blank and event.start_full != blank and event.end_full != blank -%}
{%- capture event_key -%}~{{ normalized_title | url_encode }}|{% if event.all_day %}{{ event.start_full | date: '%Y-%m-%d' }}|{{ event.end_full | date: '%Y-%m-%d' }}{% else %}{{ event.start_full | date: '%s' }}|{{ event.end_full | date: '%s' }}{% endif %}|{{ event.all_day }}|{{ normalized_location | url_encode }}~{%- endcapture -%}
{%- else -%}{%- assign event_key = '' -%}{%- endif -%}{{ event_key }}{% endunless %}{% endfor %}{% endcapture %}
{% capture ali_keys %}{% for event in ali_events %}{% assign event_status = event.status | downcase %}{% unless event_status == 'cancelled' or event_status == 'canceled' %}{%- assign normalized_title = event.summary | strip | downcase -%}
{%- assign normalized_location = event.location | strip | downcase -%}
{%- if event.summary != blank and event.start_full != blank and event.end_full != blank -%}
{%- capture event_key -%}~{{ normalized_title | url_encode }}|{% if event.all_day %}{{ event.start_full | date: '%Y-%m-%d' }}|{{ event.end_full | date: '%Y-%m-%d' }}{% else %}{{ event.start_full | date: '%s' }}|{{ event.end_full | date: '%s' }}{% endif %}|{{ event.all_day }}|{{ normalized_location | url_encode }}~{%- endcapture -%}
{%- else -%}{%- assign event_key = '' -%}{%- endif -%}{{ event_key }}{% endunless %}{% endfor %}{% endcapture %}
{% comment %}CalendarMerge:setup:end{% endcomment %}
{% assign daily_verse = private_plugin_536052.merge_variables.rss.channel.item | first %}
{% assign weather = private_plugin_536062.merge_variables %}
{% assign sports = private_plugin_536071.merge_variables %}
{% assign now_ts = trmnl.system.timestamp_utc | plus: 0 %}
{% assign local_now = now_ts | plus: trmnl.user.utc_offset %}
{% assign today = local_now | date: '%Y-%m-%d' %}

{% comment %}iOS Gazette: shared styles synced from design/gazette.css; no branding displayed{% endcomment %}
<style>
/* The iOS Gazette / shared presentation tokens — v1.1, 2026-11-15.
   Canonical CSS. Synced verbatim into the four non-Market custom views.
   Layout CSS pixels correspond to TRMNL's 1040×780 canvas. */
.gz { font-family:Arial,Helvetica,sans-serif!important; color:#111; width:100%; gap:8px!important; }
.gz * {box-sizing:border-box;}
.gz .gz-mast { width:100%; border-bottom:2px solid #171717; padding-bottom:9px; align-items:flex-end; }
.gz .gz-title {font-family:Georgia,"Times New Roman",serif!important; font-size:36px!important; line-height:1.05!important; font-weight:700!important; letter-spacing:-.65px!important; }
.gz .gz-section {font-family:Georgia,"Times New Roman",serif!important; font-size:23px!important; font-weight:700!important; line-height:1.12!important; letter-spacing:-.25px!important;}
.gz .gz-subsection {font-family:Georgia,"Times New Roman",serif!important; font-size:19px!important; font-weight:700!important; line-height:1.13!important;}
.gz .gz-date {font-size:14px!important; font-weight:600!important; text-align:right;}
.gz .gz-caption {font-size:12px!important; color:#666!important; line-height:1.22!important;}
.gz .gz-kicker {font-size:12px!important; font-weight:700!important; letter-spacing:.7px!important; line-height:1.17!important; color:#555!important;}
.gz .gz-number {font-size:31px!important; font-weight:750!important; line-height:1.07!important; font-variant-numeric:tabular-nums!important;}
.gz .gz-hairline {border-top:1px solid #dadada;}
.gz .gz-major-rule {border-top:2px solid #222;padding-top:10px;}
.gz .gz-panels {gap:0!important;}
.gz .gz-panel {background:transparent!important;border:0!important;outline:none!important;box-shadow:none!important;border-radius:0!important;padding:9px 12px!important;}
.gz .gz-panel:first-child {padding-left:0!important;}
.gz .gz-panel:last-child {padding-right:0!important;}
 .gz .gz-panel--side, .gz .gz-panels > .gz-panel:not(:first-child) {border-left:1px solid #d8d8d8!important;}
.gz .gz-panel--top {border-top:1px solid #ddd!important;}
.gz .gz-panel--lead {border-left:3px solid #222!important;padding-left:13px!important;}
.gz .gz-compact {gap:5px!important;}
.gz .gz-rows {border-top:1px solid #d6d6d6!important;}
.gz .gz-rows th {border-bottom:1px solid #bbb!important;padding-top:8px!important;padding-bottom:8px!important;}
 .gz .gz-rows td {border-bottom:1px solid #e0e0e0!important;padding-top:4px!important;padding-bottom:4px!important;vertical-align:top;}
.gz .gz-rows .gz-subsection {font-size:17px!important;white-space:nowrap;}
.gz .gz-panel.gz-major-rule {border-top:2px solid #222!important;}
.gz .gz-rows thead .label {font-size:12px!important;letter-spacing:.65px!important;font-weight:700!important;color:#555!important;}
.gz .gz-rows [data-clamp] {font-weight:550;}
 .gz .gz-chart svg {overflow:visible;}
.gz [data-person] {background:transparent!important;border:0!important;outline:none!important;border-radius:0!important;padding:4px!important;}
.gz .gz-footer {border-top:1px solid #ddd;padding-top:4px;font-size:12px;color:#666;}

/* Built-in TRMNL title bar is outside .gz; scope of this stylesheet is one plugin render. */
.title_bar {background:transparent!important;border-top:1px solid #d5d5d5!important;border-radius:0!important;box-shadow:none!important;padding-top:5px!important;}
.title_bar .title {font-size:13px!important;font-weight:700!important;}
.title_bar .instance {font-size:12px!important;color:#686868!important;}
</style>
<style>
/* Home Page: local editorial details; shared gazebo tokens remain in design/gazette.css. */
.gz-home {gap:6px!important;}
.gz-home .gz-mast {padding-bottom:6px!important;}
.gz-home .gz-home-hero {gap:0!important; align-items:stretch;}
.gz-home .gz-home-hero .gz-panel {padding-top:7px!important;padding-bottom:7px!important;}
.gz-home .gz-home-verse {justify-content:center!important;min-width:0;}
.gz-home .gz-verse-label {font-size:11px!important;font-weight:750;letter-spacing:.8px;}
.gz-home .gz-verse-copy {font-family:Arial,Helvetica,sans-serif!important;font-size:16px;font-weight:550;line-height:1.24;margin:3px 0 0!important;color:#111;overflow-wrap:break-word;}
.gz-home .gz-verse-copy::first-letter {font-family:Georgia,"Times New Roman",serif!important;font-weight:700;font-size:2.7em;line-height:.79;float:left;margin:4px 7px 0 0;}
.gz-home .gz-verse-copy.gz-verse-long {font-size:14px;line-height:1.21;}
.gz-home .gz-balance {justify-content:center!important;}
.gz-home .gz-rows {width:100%;table-layout:fixed;}
.gz-home .gz-rows th {padding-top:5px!important;padding-bottom:5px!important;}
.gz-home .gz-rows td {padding-top:3px!important;padding-bottom:3px!important;}
.gz-home .gz-agenda-list {gap:4px!important;min-width:0;}
.gz-home .gz-agenda-item {display:flex;align-items:flex-start;gap:7px;min-width:0;width:100%;}
.gz-home .gz-agenda-icon {width:21px!important;height:21px!important;flex:0 0 21px;object-fit:contain;margin-top:1px;}
.gz-home .gz-agenda-copy {display:flex;flex-direction:column;gap:1px;min-width:0;flex:1 1 auto;}
.gz-home .gz-agenda-title {display:block;font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:700;line-height:1.12;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;}
.gz-home .gz-agenda-when {display:block;font-size:12px;line-height:1.14;color:#555;font-weight:500;}
.gz-home .gz-rows .gz-subsection {font-size:16px!important;}
</style>
<div class="layout layout--col layout--top gap--small gz gz-home">
  <div class="flex flex--row flex--between flex--center-y w--full gz-mast">
    <div class="flex flex--col gap--xsmall">
      <span class="title title--large lg:title--xxlarge w--full text--left gz-title">Alvey Command Center</span>
      <span class="label w--full text--left">Noblesville, Indiana{% if weather.current.temperature_2m != nil %} · Now {{ weather.current.temperature_2m | round }}°F{% endif %}</span>
    </div>
    <span class="label label--large gz-date">{{ local_now | date: '%A, %B %-d' }}</span>
  </div>

  <div class="grid grid--cols-12 gap--medium w--full gz-panels gz-home-hero">
    <div class="col--span-7 flex flex--col gap--xsmall p--3 gz-panel gz-panel--lead gz-home-verse">
      {% if daily_verse.description != blank %}
        <div class="flex flex--row flex--between w--full">
          <span class="label label--small gz-verse-label">VERSE OF THE DAY</span>
          <span class="label label--small">{{ daily_verse.title | escape }} · NLT</span>
        </div>
        {% assign verse_length = daily_verse.description | size %}
        <p class="gz-verse-copy {% if verse_length > 165 %}gz-verse-long{% endif %}">{{ daily_verse.description | strip | escape }}</p>
      {% else %}
        <span class="label w--full text--left">Verse of the day unavailable</span>
      {% endif %}
    </div>

    <div class="col--span-5 flex flex--col gap--xsmall p--2 gz-panel gz-panel--side gz-balance" data-balance-card data-now="{{ trmnl.system.timestamp_utc }}" data-utc-offset="{{ trmnl.user.utc_offset }}">
      <div class="flex flex--row flex--between w--full">
        <span class="title title--small gz-subsection">Today's Balance</span>
        <span class="label label--small label--gray" data-balance-status>Oura readiness</span>
      </div>
      <div class="flex flex--row flex--between flex--center-y gap--small w--full">
        <div class="flex flex--col flex--center-x gap--xsmall">
          <div class="flex flex--row flex--center-y gap--xsmall">
            <span class="w--2 h--2 rounded--full bg--black"></span>
            <span class="label">Stuart</span>
          </div>
          <span class="title title--large value--tnums" data-balance-stuart-percent>—</span>
          <span class="label label--small label--gray">Readiness: <span data-balance-stuart-score>—</span></span>
        </div>
        <svg class="w--20 h--20 no-shrink" viewBox="0 0 80 80" role="img" aria-label="Readiness balance" data-balance-chart>
          <circle class="text--gray-40" cx="40" cy="40" r="29" fill="none" stroke="currentColor" stroke-width="10"/>
          <circle class="text--black" cx="40" cy="40" r="29" fill="none" stroke="currentColor" stroke-width="10" pathLength="100" stroke-dasharray="0 100" transform="rotate(-90 40 40)" data-balance-stuart-arc/>
          <path class="text--gray-30" d="M40 47 30 37a6 6 0 0 1 10-6 6 6 0 0 1 10 6Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        </svg>
        <div class="flex flex--col flex--center-x gap--xsmall">
          <div class="flex flex--row flex--center-y gap--xsmall">
            <span class="w--2 h--2 rounded--full bg--gray-40"></span>
            <span class="label">Ali</span>
          </div>
          <span class="title title--large value--tnums" data-balance-ali-percent>—</span>
          <span class="label label--small label--gray">Readiness: <span data-balance-ali-score>—</span></span>
        </div>
      </div>
      <template data-balance-source="stuart">{{ oura_536089.markup_full | escape }}</template>
      <template data-balance-source="ali">{{ oura_536097.markup_full | escape }}</template>
    </div>
  </div>

  <table class="table table--base gz-rows" data-table-limit="true" data-table-max-height="auto">
    <thead>
      <tr>
        <th class="w--24"><span class="label label--gray">DAY</span></th>
        <th><span class="label label--gray">FAMILY</span></th>
        <th class="w--64"><span class="label label--gray">GAMES</span></th>
        <th class="w--36"><span class="label label--gray">WEATHER</span></th>
        <th class="w--16"><span class="label label--gray">PRECIP.</span></th>
      </tr>
    </thead>
    <tbody>
      {% for offset in (0..6) %}
        {% assign day_seconds = offset | times: 86400 %}
        {% assign day_stamp = local_now | plus: day_seconds %}
        {% assign day = day_stamp | date: '%Y-%m-%d' %}
        {% assign weather_index = nil %}
        {% for forecast_day in weather.daily.time %}
          {% if forecast_day == day %}
            {% assign weather_index = forloop.index0 %}
            {% break %}
          {% endif %}
        {% endfor %}
        <tr>
          <td>
            <div class="flex flex--col gap--xsmall w--full">
              <span class="title title--small w--full text--left gz-subsection">{% if offset == 0 %}Today{% else %}{{ day_stamp | date: '%a' }}{% endif %}</span>
              <span class="label label--gray w--full text--left">{{ day_stamp | date: '%b %-d' }}</span>
            </div>
          </td>
          <td>
            <div class="flex flex--col gap--xsmall w--full gz-agenda-list">
{% comment %}CalendarMerge:day:start{% endcomment %}
              {% assign day_events = 0 %}
              {% assign seen_keys = '' %}
              {% for event in events %}
                {% assign event_day = event.start_full | date: '%Y-%m-%d' %}
                {% assign event_end_day = event.end_full | date: '%Y-%m-%d' %}
                {% assign end_clock = event.end_full | slice: 11, 8 %}
                {% assign status = event.status | downcase %}
                {% assign on_day = false %}
                {% if event_day == day %}
                  {% assign on_day = true %}
                {% elsif event_day < day %}
                  {% if event_end_day > day %}
                    {% assign on_day = true %}
                  {% elsif event_end_day == day and event.all_day == false and end_clock != '00:00:00' %}
                    {% assign on_day = true %}
                  {% endif %}
                {% endif %}
                {% unless status == 'cancelled' or status == 'canceled' %}
                  {% if on_day %}
                    {%- assign normalized_title = event.summary | strip | downcase -%}
{%- assign normalized_location = event.location | strip | downcase -%}
{%- if event.summary != blank and event.start_full != blank and event.end_full != blank -%}
{%- capture event_key -%}~{{ normalized_title | url_encode }}|{% if event.all_day %}{{ event.start_full | date: '%Y-%m-%d' }}|{{ event.end_full | date: '%Y-%m-%d' }}{% else %}{{ event.start_full | date: '%s' }}|{{ event.end_full | date: '%s' }}{% endif %}|{{ event.all_day }}|{{ normalized_location | url_encode }}~{%- endcapture -%}
{%- else -%}{%- assign event_key = '' -%}{%- endif -%}
                    {% if event_key != blank and seen_keys contains event_key %}{% continue %}{% endif %}
                    {% assign seen_keys = seen_keys | append: event_key %}
                    {% assign owner = 'S' %}
                    {% if event_key != blank and ali_keys contains event_key %}{% assign owner = 'A' %}{% if stu_keys contains event_key %}{% assign owner = 'S+A' %}{% endif %}{% elsif event_key == blank %}{% if ali_events contains event %}{% assign owner = 'A' %}{% endif %}{% endif %}
                    {% assign source_calendar = event.calname | strip | downcase %}
                    {% if source_calendar == 'us holidays' %}{% assign owner = 'H' %}{% endif %}
                    {% assign day_events = day_events | plus: 1 %}
                    <div class="gz-agenda-item" data-owner="{{ owner }}" data-agenda-kind="family">
                      <svg class="gz-agenda-icon" viewBox="0 0 28 28" role="img" aria-label="{% if owner == 'H' %}Holiday{% elsif owner == 'S' %}Stuart{% elsif owner == 'A' %}Ali{% else %}Stuart and Ali{% endif %}" xmlns="http://www.w3.org/2000/svg">
                        {% if owner == 'S' %}
                          <circle cx="14" cy="6.5" r="4.5" fill="#111"/>
                          <path d="M5.5 26v-8.5c0-4.4 3.8-7 8.5-7s8.5 2.6 8.5 7V26Z" fill="#111"/>
                        {% elsif owner == 'A' %}
                          <path d="M7.3 11.1C6.2 4.8 9.3 2 14 2s7.8 2.8 6.7 9.1l2.4 3.4h-5.1l-1.2-3.2H11l-1.2 3.2H4.9Z" fill="#333"/>
                          <circle cx="14" cy="7" r="3.5" fill="#fff"/>
                          <path d="M9.8 13h8.4L22 25.5H6Z" fill="#111"/>
                        {% elsif owner == 'S+A' %}
                          <circle cx="8.7" cy="7.5" r="3.7" fill="#111"/>
                          <circle cx="19.3" cy="7.5" r="3.7" fill="#555"/>
                          <path d="M2 26v-8c0-4 2.9-6.4 6.7-6.4s6.7 2.4 6.7 6.4v8Z" fill="#111"/>
                          <path d="M12.6 26v-8c0-4 2.9-6.4 6.7-6.4S26 14 26 18v8Z" fill="#555"/>
                          <path d="M11.7 18.3l2.3 1.9 2.3-1.9" stroke="#fff" stroke-width="1.5" fill="none" stroke-linecap="round"/>
                        {% elsif owner == 'H' %}
                          <rect x="3.5" y="5" width="21" height="19" rx="2" fill="none" stroke="#222" stroke-width="2"/>
                          <path d="M4.5 11h19M9 3v5M19 3v5" stroke="#222" stroke-width="2" stroke-linecap="round"/>
                          <path d="m14 13.6 1.2 3 3.2.2-2.5 2 1 3-2.9-1.7-2.9 1.7 1-3-2.5-2 3.2-.2Z" fill="#222"/>
                        {% endif %}
                      </svg>
                      <div class="gz-agenda-copy">
                        <span class="gz-agenda-title" data-clamp="1">{{ event.summary | default: 'Untitled event' | escape }}</span>
                        <span class="gz-agenda-when">{% if event.all_day %}All day{% elsif event_day < day %}Continues{% else %}{{ event.start | escape }}{% endif %}</span>
                      </div>
                    </div>
                  {% endif %}
                {% endunless %}
              {% endfor %}
              {% if stu_calendar.events == nil and ali_calendar.events == nil %}
                <span class="label label--gray w--full text--left">Calendar unavailable</span>
              {% elsif day_events == 0 %}
                <span class="label label--gray w--full text--left">No events scheduled</span>
              {% endif %}
              {% if stu_calendar.events == nil and ali_calendar.events != nil %}<span class="label label--small label--gray">Stuart calendar unavailable</span>{% elsif ali_calendar.events == nil and stu_calendar.events != nil %}<span class="label label--small label--gray">Ali calendar unavailable</span>{% endif %}
{% comment %}CalendarMerge:day:end{% endcomment %}
            </div>
          </td>
          <td>
            <div class="flex flex--col gap--xsmall w--full gz-agenda-list">
              {% assign day_games = 0 %>
              {% for game in sports.games %}
                {% if game.day == day %}
                  {% assign day_games = day_games | plus: 1 %}
                  <div class="gz-agenda-item" data-agenda-kind="sports">
                    {% if game.logo != blank %}
                      <img class="image image-dither gz-agenda-icon" src="{{ game.logo | escape }}" alt="{{ game.team | escape }}">
                    {% else %}
                      <svg class="gz-agenda-icon" viewBox="0 0 28 28" role="img" aria-label="Sports event"><circle cx="14" cy="14" r="10" fill="none" stroke="#222" stroke-width="2"/><path d="m8 14 4 4 8-9" fill="none" stroke="#222" stroke-width="2"/></svg>
                    {% endif %}
                    <div class="gz-agenda-copy">
                      <span class="gz-agenda-title" data-clamp="1">{{ game.matchup | escape }}</span>
                      <span class="gz-agenda-when">{{ game.time_label | escape }}</span>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
              {% if day_games == 0 %}
                <span class="label label--gray w--full text--left">{% if sports.status == 'ok' %}—{% else %}Unavailable{% endif %}</span>
              {% endif %}
            </div>
          </td>
          <td>
            {% if weather_index != nil %}
              {% assign code = weather.daily.weather_code[weather_index] %}
              {% capture condition %}{% case code %}{% when 0 %}Sunny{% when 1 %}Mostly sunny{% when 2 %}Partly cloudy{% when 3 %}Overcast{% when 45, 48 %}Fog{% when 51, 53, 55 %}Drizzle{% when 56, 57 %}Freezing drizzle{% when 61 %}Light rain{% when 63 %}Rain{% when 65 %}Heavy rain{% when 66, 67 %}Freezing rain{% when 71 %}Light snow{% when 73 %}Snow{% when 75 %}Heavy snow{% when 77 %}Snow grains{% when 80, 81, 82 %}Rain showers{% when 85, 86 %}Snow showers{% when 95 %}Thunderstorms{% when 96, 99 %}Storms / hail{% else %}Unavailable{% endcase %}{% endcapture %}
              <div class="flex flex--row gap--small w--full">
                {% render "weather_icon", code: code, description: condition %}
                <div class="flex flex--col gap--xsmall">
                  <span class="title title--small w--full text--left">H {% if weather.daily.temperature_2m_max[weather_index] != nil %}{{ weather.daily.temperature_2m_max[weather_index] | round }}°{% else %}—{% endif %}</span>
                  <span class="label label--gray w--full text--left">L {% if weather.daily.temperature_2m_min[weather_index] != nil %}{{ weather.daily.temperature_2m_min[weather_index] | round }}°{% else %}—{% endif %}</span>
                </div>
              </div>
            {% else %}
              <span class="label label--gray">Unavailable</span>
            {% endif %}
          </td>
          <td>
            {% if weather_index != nil %}
              {% assign chance = weather.daily.precipitation_probability_max[weather_index] %}
              {% if chance != nil %}
                <span class="title title--small">{{ chance | round }}%</span>
              {% else %}
                <span class="label label--gray">—</span>
              {% endif %}
            {% else %}
              <span class="label label--gray">—</span>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<div class="title_bar">
  <span class="title">{{ trmnl.plugin_settings.instance_name | escape }}</span>
  <span class="instance">7 days · ET · °F · ESPN / Open-Meteo{% if sports.status != 'ok' %} · Sports incomplete{% endif %}</span>
</div>
