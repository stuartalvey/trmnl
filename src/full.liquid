{% comment %}
  Alvey Command Center: calendar and daily Noblesville forecasts joined by local date.
  Weather: Open-Meteo (CC BY 4.0). Event and forecast values remain in TRMNL.
  WMO weather interpretation codes: https://open-meteo.com/en/docs
{% endcomment %}
{% comment %}CalendarMerge:setup:start{% endcomment %}
{% comment %}Calendar merge: conservative title/time/type/location matching; no private event fixtures.{% endcomment %}
{% assign stu_calendar = apple_calendar_535612 %}
{% assign ali_calendar = apple_calendar_536125 %}
{% assign stu_events = stu_calendar.events | default: empty | sort: 'start_full' %}
{% assign ali_events = ali_calendar.events | default: empty | sort: 'start_full' %}
{% assign events = stu_events | concat: ali_events | sort: 'start_full' %}
{% capture stu_keys %}{% for event in stu_events %}{% assign event_status = event.status | downcase %}{% unless event_status == 'cancelled' or event_status == 'canceled' %}{%- assign normalized_title = event.summary | strip | downcase -%}
{%- assign normalized_location = event.location | strip | downcase -%}
{%- if event.summary != blank and event.start_full != blank and event.end_full != blank -%}
{%- capture event_key -%}~{{ normalized_title | url_encode }}|{% if event.all_day %}{{ event.start_full | date: '%Y-%m-%d' }}|{{ event.end_full | date: '%Y-%m-%d' }}{% else %}{{ event.start_full | date: '%s' }}|{{ event.end_full | date: '%s' }}{% endif %}|{{ event.all_day }}|{{ normalized_location | url_encode }}~{%- endcapture -%}
{%- else -%}{%- assign event_key = '' -%}{%- endif -%}{{ event_key }}{% endunless %}{% endfor %}{% endcapture %}
{% capture ali_keys %}{% for event in ali_events %}{% assign event_status = event.status | downcase %}{% unless event_status == 'cancelled' or event_status == 'canceled' %}{%- assign normalized_title = event.summary | strip | downcase -%}
{%- assign normalized_location = event.location | strip | downcase -%}
{%- if event.summary != blank and event.start_full != blank and event.end_full != blank -%}
{%- capture event_key -%}~{{ normalized_title | url_encode }}|{% if event.all_day %}{{ event.start_full | date: '%Y-%m-%d' }}|{{ event.end_full | date: '%Y-%m-%d' }}{% else %}{{ event.start_full | date: '%s' }}|{{ event.end_full | date: '%s' }}{% endif %}|{{ event.all_day }}|{{ normalized_location | url_encode }}~{%- endcapture -%}
{%- else -%}{%- assign event_key = '' -%}{%- endif -%}{{ event_key }}{% endunless %}{% endfor %}{% endcapture %}
{% comment %}CalendarMerge:setup:end{% endcomment %}
{% assign daily_verse = private_plugin_536052.merge_variables.rss.channel.item | first %}
{% assign weather = private_plugin_536062.merge_variables %}
{% assign sports = private_plugin_536071.merge_variables %}
{% assign now_ts = trmnl.system.timestamp_utc | plus: 0 %}
{% assign local_now = now_ts | plus: trmnl.user.utc_offset %}
{% assign today = local_now | date: '%Y-%m-%d' %}

<div class="layout layout--col layout--top gap--small">
  <div class="flex flex--row flex--between flex--center-y w--full">
    <div class="flex flex--col gap--xsmall">
      <span class="title title--large lg:title--xxlarge w--full text--left">Alvey Command Center</span>
      <span class="label w--full text--left">Noblesville, Indiana{% if weather.current.temperature_2m != nil %} · Now {{ weather.current.temperature_2m | round }}°F{% endif %}</span>
    </div>
    <span class="label label--large">{{ local_now | date: '%A, %B %-d' }}</span>
  </div>

  <div class="grid grid--cols-12 gap--medium w--full">
    <div class="col--span-7 flex flex--col flex--left flex--center-y gap--small bg--gray-75 rounded--large p--3">
      {% if daily_verse.description != blank %}
        <div class="flex flex--row flex--between w--full">
          <span class="label label--small">VERSE OF THE DAY</span>
          <span class="label label--small">{{ daily_verse.title | escape }} · NLT</span>
        </div>
        <span class="description description--large w--full text--left">{{ daily_verse.description | escape }}</span>
      {% else %}
        <span class="label w--full text--left">Verse of the day unavailable</span>
      {% endif %}
    </div>

    <div class="col--span-5 flex flex--col gap--small outline outline--muted rounded--large p--2" data-balance-card data-now="{{ trmnl.system.timestamp_utc }}" data-utc-offset="{{ trmnl.user.utc_offset }}">
      <div class="flex flex--row flex--between w--full">
        <span class="title title--small">Today's Balance</span>
        <span class="label label--small label--gray" data-balance-status>Oura readiness</span>
      </div>
      <div class="flex flex--row flex--between flex--center-y gap--small w--full">
        <div class="flex flex--col flex--center-x gap--xsmall">
          <div class="flex flex--row flex--center-y gap--xsmall">
            <span class="w--2 h--2 rounded--full bg--black"></span>
            <span class="label">Stuart</span>
          </div>
          <span class="title title--large value--tnums" data-balance-stuart-percent>—</span>
          <span class="label label--small label--gray">Readiness: <span data-balance-stuart-score>—</span></span>
        </div>
        <svg class="w--20 h--20 no-shrink" viewBox="0 0 80 80" role="img" aria-label="Readiness balance" data-balance-chart>
          <circle class="text--gray-40" cx="40" cy="40" r="29" fill="none" stroke="currentColor" stroke-width="10"/>
          <circle class="text--black" cx="40" cy="40" r="29" fill="none" stroke="currentColor" stroke-width="10" pathLength="100" stroke-dasharray="0 100" transform="rotate(-90 40 40)" data-balance-stuart-arc/>
          <path class="text--gray-30" d="M40 47 30 37a6 6 0 0 1 10-6 6 6 0 0 1 10 6Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        </svg>
        <div class="flex flex--col flex--center-x gap--xsmall">
          <div class="flex flex--row flex--center-y gap--xsmall">
            <span class="w--2 h--2 rounded--full bg--gray-40"></span>
            <span class="label">Ali</span>
          </div>
          <span class="title title--large value--tnums" data-balance-ali-percent>—</span>
          <span class="label label--small label--gray">Readiness: <span data-balance-ali-score>—</span></span>
        </div>
      </div>
      <template data-balance-source="stuart">{{ oura_536089.markup_full | escape }}</template>
      <template data-balance-source="ali">{{ oura_536097.markup_full | escape }}</template>
    </div>
  </div>

  <table class="table table--base" data-table-limit="true" data-table-max-height="auto">
    <thead>
      <tr>
        <th class="w--24"><span class="label label--gray">DAY</span></th>
        <th><span class="label label--gray">FAMILY · S = Stu · A = Ali · H = Holiday</span></th>
        <th class="w--64"><span class="label label--gray">GAMES</span></th>
        <th class="w--36"><span class="label label--gray">WEATHER</span></th>
        <th class="w--16"><span class="label label--gray">PRECIP.</span></th>
      </tr>
    </thead>
    <tbody>
      {% for offset in (0..6) %}
        {% assign day_seconds = offset | times: 86400 %}
        {% assign day_stamp = local_now | plus: day_seconds %}
        {% assign day = day_stamp | date: '%Y-%m-%d' %}
        {% assign weather_index = nil %}
        {% for forecast_day in weather.daily.time %}
          {% if forecast_day == day %}
            {% assign weather_index = forloop.index0 %}
            {% break %}
          {% endif %}
        {% endfor %}
        <tr>
          <td>
            <div class="flex flex--col gap--xsmall w--full">
              <span class="title title--small w--full text--left">{% if offset == 0 %}Today{% elsif offset == 1 %}Tomorrow{% else %}{{ day_stamp | date: '%a' }}{% endif %}</span>
              <span class="label label--gray w--full text--left">{{ day_stamp | date: '%b %-d' }}</span>
            </div>
          </td>
          <td>
            <div class="flex flex--col gap--small w--full">
{% comment %}CalendarMerge:day:start{% endcomment %}
              {% assign day_events = 0 %}
              {% assign seen_keys = '' %}
              {% for event in events %}
                {% assign event_day = event.start_full | date: '%Y-%m-%d' %}
                {% assign event_end_day = event.end_full | date: '%Y-%m-%d' %}
                {% assign end_clock = event.end_full | slice: 11, 8 %}
                {% assign status = event.status | downcase %}
                {% assign on_day = false %}
                {% if event_day == day %}
                  {% assign on_day = true %}
                {% elsif event_day < day %}
                  {% if event_end_day > day %}
                    {% assign on_day = true %}
                  {% elsif event_end_day == day and event.all_day == false and end_clock != '00:00:00' %}
                    {% assign on_day = true %}
                  {% endif %}
                {% endif %}
                {% unless status == 'cancelled' or status == 'canceled' %}
                  {% if on_day %}
                    {%- assign normalized_title = event.summary | strip | downcase -%}
{%- assign normalized_location = event.location | strip | downcase -%}
{%- if event.summary != blank and event.start_full != blank and event.end_full != blank -%}
{%- capture event_key -%}~{{ normalized_title | url_encode }}|{% if event.all_day %}{{ event.start_full | date: '%Y-%m-%d' }}|{{ event.end_full | date: '%Y-%m-%d' }}{% else %}{{ event.start_full | date: '%s' }}|{{ event.end_full | date: '%s' }}{% endif %}|{{ event.all_day }}|{{ normalized_location | url_encode }}~{%- endcapture -%}
{%- else -%}{%- assign event_key = '' -%}{%- endif -%}
                    {% if event_key != blank and seen_keys contains event_key %}{% continue %}{% endif %}
                    {% assign seen_keys = seen_keys | append: event_key %}
                    {% assign owner = 'S' %}
                    {% if event_key != blank and ali_keys contains event_key %}{% assign owner = 'A' %}{% if stu_keys contains event_key %}{% assign owner = 'S+A' %}{% endif %}{% elsif event_key == blank %}{% if ali_events contains event %}{% assign owner = 'A' %}{% endif %}{% endif %}
                    {% assign source_calendar = event.calname | strip | downcase %}
                    {% if source_calendar == 'us holidays' %}{% assign owner = 'H' %}{% endif %}
                    {% assign day_events = day_events | plus: 1 %}
                    <div class="flex flex--row gap--small w--full">
                      <span class="label w--24 text--left">{% if event.all_day %}All day{% elsif event_day < day %}Continues{% else %}{{ event.start | escape }}{% endif %}</span>
                      <span class="label label--small label--gray w--8 text--center" title="{% if owner == 'H' %}Holiday{% elsif owner == 'S' %}Stuart calendar{% elsif owner == 'A' %}Ali calendar{% else %}Both calendars{% endif %}">{{ owner }}</span>
                      <span class="title title--small text--left stretch" data-clamp="1">{{ event.summary | default: 'Untitled event' | escape }}</span>
                    </div>
                  {% endif %}
                {% endunless %}
              {% endfor %}
              {% if stu_calendar.events == nil and ali_calendar.events == nil %}
                <span class="label label--gray w--full text--left">Calendar unavailable</span>
              {% elsif day_events == 0 %}
                <span class="label label--gray w--full text--left">No events scheduled</span>
              {% endif %}
              {% if stu_calendar.events == nil and ali_calendar.events != nil %}<span class="label label--small label--gray">Stuart calendar unavailable</span>{% elsif ali_calendar.events == nil and stu_calendar.events != nil %}<span class="label label--small label--gray">Ali calendar unavailable</span>{% endif %}
{% comment %}CalendarMerge:day:end{% endcomment %}
            </div>
          </td>
          <td>
            <div class="flex flex--col gap--small w--full">
              {% assign day_games = 0 %}
              {% for game in sports.games %}
                {% if game.day == day %}
                  {% assign day_games = day_games | plus: 1 %}
                  <div class="flex flex--row gap--small w--full">
                    {% if game.logo != blank %}
                      <img class="image image-dither w--5 h--5" src="{{ game.logo | escape }}" alt="{{ game.team | escape }}">
                    {% endif %}
                    <div class="flex flex--col gap--none stretch">
                      <span class="title title--small w--full text--left" data-clamp="1">{{ game.matchup | escape }}</span>
                      <span class="label label--small w--full text--left">{{ game.time_label | escape }}</span>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
              {% if day_games == 0 %}
                <span class="label label--gray w--full text--left">{% if sports.status == 'ok' %}—{% else %}Unavailable{% endif %}</span>
              {% endif %}
            </div>
          </td>
          <td>
            {% if weather_index != nil %}
              {% assign code = weather.daily.weather_code[weather_index] %}
              {% capture condition %}{% case code %}{% when 0 %}Sunny{% when 1 %}Mostly sunny{% when 2 %}Partly cloudy{% when 3 %}Overcast{% when 45, 48 %}Fog{% when 51, 53, 55 %}Drizzle{% when 56, 57 %}Freezing drizzle{% when 61 %}Light rain{% when 63 %}Rain{% when 65 %}Heavy rain{% when 66, 67 %}Freezing rain{% when 71 %}Light snow{% when 73 %}Snow{% when 75 %}Heavy snow{% when 77 %}Snow grains{% when 80, 81, 82 %}Rain showers{% when 85, 86 %}Snow showers{% when 95 %}Thunderstorms{% when 96, 99 %}Storms / hail{% else %}Unavailable{% endcase %}{% endcapture %}
              <div class="flex flex--row gap--small w--full">
                {% render "weather_icon", code: code, description: condition %}
                <div class="flex flex--col gap--xsmall">
                  <span class="title title--small w--full text--left">H {% if weather.daily.temperature_2m_max[weather_index] != nil %}{{ weather.daily.temperature_2m_max[weather_index] | round }}°{% else %}—{% endif %}</span>
                  <span class="label label--gray w--full text--left">L {% if weather.daily.temperature_2m_min[weather_index] != nil %}{{ weather.daily.temperature_2m_min[weather_index] | round }}°{% else %}—{% endif %}</span>
                </div>
              </div>
            {% else %}
              <span class="label label--gray">Unavailable</span>
            {% endif %}
          </td>
          <td>
            {% if weather_index != nil %}
              {% assign chance = weather.daily.precipitation_probability_max[weather_index] %}
              {% if chance != nil %}
                <span class="title title--small">{{ chance | round }}%</span>
              {% else %}
                <span class="label label--gray">—</span>
              {% endif %}
            {% else %}
              <span class="label label--gray">—</span>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<div class="title_bar">
  <span class="title">{{ trmnl.plugin_settings.instance_name | escape }}</span>
  <span class="instance">7 days · ET · °F · ESPN / Open-Meteo{% if sports.status != 'ok' %} · Sports incomplete{% endif %}</span>
</div>
