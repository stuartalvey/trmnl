{% assign now_ts = trmnl.system.timestamp_utc | plus: 0 %}
{% assign local_now = now_ts | plus: trmnl.user.utc_offset %}
{% assign updated_ts = updated_at | date: '%s' | plus: 0 %}
{% assign age = now_ts | minus: updated_ts %}
{% assign report = housing.report %}
<div class="layout layout--col layout--top gap--small">
  <div class="flex flex--row flex--between flex--center-y w--full">
    <span class="title title--large lg:title--xxlarge">Alvey Market Intelligence</span>
    <div class="flex flex--col flex--right gap--xsmall">
      <span class="label">{{ local_now | date: '%A, %B %-d' }} · Markets · Homes · News</span>
      <span class="label label--small label--gray">{% if updated_at == nil %}Waiting for feeds{% elsif age > 3900 or age < -600 %}Data needs refresh{% else %}Fetched {{ updated_ts | plus: trmnl.user.utc_offset | date: '%-I:%M %p' }} ET{% endif %}</span>
    </div>
  </div>
  <div class="flex flex--row flex--between flex--center-y w--full"><span class="title">Financial Markets</span><span class="label label--small label--gray">Stocks vs previous close · Bitcoin 24-hour change</span></div>
  <div class="grid grid--cols-3 gap--medium w--full">
    {% for market in markets %}
    <div class="flex flex--col gap--xsmall stretch bg--gray-75 rounded--large p--2">
      <div class="flex flex--row flex--between flex--center-y w--full"><span class="title title--small">{{ market.label | escape }}</span><span class="label label--small label--gray">{% if market.label == 'S&P 500' %}INDEX{% elsif market.label == 'Eli Lilly' %}LLY{% else %}BTC / USD{% endif %}</span></div>
      {% if market.status == 'ok' %}
      <div class="flex flex--row flex--between flex--center-y w--full"><span class="value value--medium">{{ market.price_str | escape }}</span><span class="title title--small">{{ market.change_str | escape }}</span></div>
      <svg class="w--full h--8" viewBox="0 0 114 40" preserveAspectRatio="none"><line x1="0" y1="38" x2="114" y2="38" stroke="#bbb"/>{% if market.spark != blank %}<polyline points="{{ market.spark | escape }}" stroke="black" stroke-width="2.5" fill="none" stroke-linejoin="round"/>{% endif %}</svg>
      <span class="label label--small label--gray">{{ market.trend_label | default: 'History unavailable' | escape }}{% if market.label != 'Bitcoin' %} · Delayed{% endif %}</span>
      {% else %}<span class="value value--medium">—</span><span class="label label--gray">Quote unavailable</span><div class="h--8"></div>{% endif %}
    </div>
    {% endfor %}
  </div>
  <div class="flex flex--row flex--between flex--center-y w--full"><span class="title">Hamilton County Real Estate</span><span class="label label--small label--gray">Indiana · Local monthly statistics · National rates</span></div>
  <div class="grid grid--cols-4 gap--small w--full">
    {% for card in housing.cards %}
      <div class="flex flex--col gap--xsmall stretch bg--gray-75 rounded--large p--2">
        <span class="label label--small label--gray">{{ card.title | escape }}</span>
        <span class="value value--medium">{{ card.display | escape }}</span>
        <div class="flex flex--row flex--between w--full">
          <span class="label label--small">{{ card.change_short | escape }}</span>
          <span class="label label--small">{{ card.change_long | escape }}</span>
        </div>
        <svg class="w--full h--10" viewBox="0 0 114 40" preserveAspectRatio="none">
          <line x1="0" y1="38" x2="114" y2="38" stroke="#bbb" stroke-width="1"/>
          {% if card.spark != blank %}
            <polyline points="{{ card.spark | escape }}" stroke="black" stroke-width="2.5" stroke-linejoin="round" fill="none"/>
          {% else %}
            <text x="57" y="23" text-anchor="middle" fill="#666" font-size="9">History unavailable</text>
          {% endif %}
        </svg>
        <span class="label label--small label--gray">{{ card.trend_label | escape }}</span>
        <span class="label label--small label--gray">{% if card.key == 'mortgage' %}National weekly survey{% else %}{{ card.subtitle | escape }}{% endif %}</span>
      </div>
    {% else %}
      <span class="label label--gray">Waiting for real estate statistics</span>
    {% endfor %}
  </div>
  <div class="flex flex--row flex--between flex--center-y w--full"><span class="title">The Briefing</span><span class="label label--small label--gray">Relevant developments · Three categories</span></div>
  <div class="grid grid--cols-3 gap--medium w--full">
    {% for category in news %}
    <div class="flex flex--col gap--xsmall outline outline--muted rounded--large p--2">
      <span class="title title--small">{{ category.name | escape }}</span>
      {% for item in category.items %}<div class="flex flex--col gap--xsmall w--full"><span class="label label--small" data-clamp="4">{{ item.title | escape }}</span><span class="label label--small label--gray">{{ item.source | escape }} · {{ item.date | date: '%b %-d' }}</span></div>
      {% else %}<span class="label label--gray">No recent headlines available</span>{% endfor %}
    </div>
    {% endfor %}
  </div>
  <div class="flex flex--row flex--between w--full"><span class="label label--small label--gray">Housing: Indiana REALTORS · Mortgage: Freddie Mac / FRED · Quotes may be delayed</span><span class="label label--small label--gray">USD · Eastern time</span></div>
</div>
