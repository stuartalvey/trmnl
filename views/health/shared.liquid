{% template recovery_person %}
<div class="flex flex--col gap--xsmall bg--gray-75 rounded--large p--2 w--full" data-person="{{ person }}">
 <div class="flex flex--row flex--between w--full"><span class="title title--small">{{ name }}</span><span class="label label--small label--gray" data-oura-status>Sync Oura</span></div>
 <div class="flex flex--row flex--between w--full">
 {% assign names = 'Readiness,Sleep,Activity' | split: ',' %}{% for name in names %}
  <div class="flex flex--col flex--center-x gap--xsmall" data-score="{{ name }}">
   <svg class="w--14 h--14" viewBox="0 0 60 60" role="img" aria-label="{{ name }} score">
    <circle cx="30" cy="30" r="24" fill="none" stroke="#ccc" stroke-width="5"/>
    <circle cx="30" cy="30" r="24" fill="none" stroke="black" stroke-width="5" pathLength="100" stroke-dasharray="0 100" transform="rotate(-90 30 30)" data-arc/>
    <text x="30" y="37" text-anchor="middle" font-family="sans-serif" font-size="22" data-number>—</text>
   </svg>
   <span class="label label--small">{{ name }}</span>
  </div>
 {% endfor %}
 </div>
</div>
{% endtemplate %}
<script>
/* HealthDetail:start */
(function(root){
 const MAX_AGE_MINUTES=360;
 const MONTHS={jan:0,feb:1,mar:2,apr:3,may:4,jun:5,jul:6,aug:7,sep:8,oct:9,nov:10,dec:11};
   function parseSnapshot(markup, nowSeconds, utcOffsetSeconds) {
    if (typeof markup !== "string" || !markup.trim()) return { status: "missing", score: null };
    // The third-party Oura plugin currently exposes rendered markup, not raw scores.
    // Match only the numeric value immediately followed by its Readiness label.
    var scoreMatch = markup.match(/<span\b[^>]*class=["'][^"']*\bvalue\b[^"']*["'][^>]*>\s*(\d{1,3})\s*<\/span>\s*<span\b[^>]*>\s*Readiness\s*<\/span>/i);
    if (!scoreMatch) return { status: "missing", score: null };
    var score = Number(scoreMatch[1]);
    if (!Number.isInteger(score) || score < 0 || score > 100) return { status: "invalid", score: null };
    var updated = markup.match(/Last\s+updated:\s*(\d{1,2})\s+([A-Za-z]{3,9})\s+(\d{1,2}):(\d{2})(?:\s*(AM|PM))?/i);
    if (!updated || !Number.isFinite(nowSeconds) || !Number.isFinite(utcOffsetSeconds)) return { status: "undated", score: score };
    var month = MONTHS[updated[2].slice(0, 3).toLowerCase()];
    var day = Number(updated[1]);
    var hour = Number(updated[3]);
    var minute = Number(updated[4]);
    if (updated[5]) {
      if (hour < 1 || hour > 12) return { status: "undated", score: score };
      hour = hour % 12 + (updated[5].toLowerCase() === "pm" ? 12 : 0);
    }
    if (month === undefined || day < 1 || day > 31 || hour < 0 || hour > 23 || minute < 0 || minute > 59) return { status: "undated", score: score };
    var localNow = new Date((nowSeconds + utcOffsetSeconds) * 1000);
    if (month !== localNow.getUTCMonth() || day !== localNow.getUTCDate()) return { status: "stale", score: score };
    var updatedMs = Date.UTC(localNow.getUTCFullYear(), month, day, hour, minute);
    var ageMinutes = (localNow.getTime() - updatedMs) / 60000;
    if (ageMinutes > MAX_AGE_MINUTES || ageMinutes < -5) return { status: "stale", score: score };
    return { status: "fresh", score: score };
  }

 function oura(markup,now,offset){
  const freshness=parseSnapshot(markup,now,offset),scores={Readiness:null,Sleep:null,Activity:null};
  // Keep valid, dated scores after freshness expires, but visually mark them stale.
  const timestamp=typeof markup==="string"?markup.match(/Last\s+updated:\s*(\d{1,2}\s+[A-Za-z]{3,9}\s+\d{1,2}:\d{2}(?:\s*(?:AM|PM))?)/i)?.[1]||null:null;
  if(freshness.status==="fresh"||freshness.status==="stale"){
   const re=/<span\b[^>]*class=["'][^"']*\bvalue\b[^"']*["'][^>]*>\s*(\d{1,3})\s*<\/span>\s*<span\b[^>]*>\s*(Readiness|Sleep|Activity)\s*<\/span>/gi;
   for(const m of markup.matchAll(re)){const n=Number(m[1]),name=Object.keys(scores).find(k=>k.toLowerCase()===m[2].toLowerCase());if(n>=0&&n<=100)scores[name]=n;}
  }
  return {status:freshness.status,scores,timestamp};
 }

 function appleSummary(samples,nowMs){
  const result={steps:null,energy:null,resting:null,last:null,lastSteps:null,recentDay:null,recentSteps:null,status:"missing"};
  if(!Array.isArray(samples))return result;
  const day=v=>{
    const p=new Intl.DateTimeFormat("en-US",{timeZone:"America/Indiana/Indianapolis",year:"numeric",month:"2-digit",day:"2-digit"}).formatToParts(new Date(v));
    const g=k=>p.find(x=>x.type===k).value;
    return g("year")+"-"+g("month")+"-"+g("day");
  };
  const today=day(nowMs),seen=new Set(),stepDays=new Map();
  let restingAt=-Infinity;
  for(const sample of samples){
    if(!sample||typeof sample.value!=="number"||!Number.isFinite(sample.value)||sample.value<0)continue;
    const start=Date.parse(sample.start_date),end=Date.parse(sample.end_date);
    if(!Number.isFinite(start)||!Number.isFinite(end)||end<start||end>nowMs+300000)continue;
    const date=day(start);
    const name=String(sample.metric_type||"").toLowerCase().replace(/[^a-z]/g,""),unit=String(sample.unit||"").toLowerCase();
    const key=[name,unit,start,end,sample.value].join("|");
    if(seen.has(key))continue;seen.add(key);
    if(/(?:stepcount|steps)$/.test(name)){
      const record=stepDays.get(date)||{count:0,last:0};
      record.count+=sample.value;record.last=Math.max(record.last,end);stepDays.set(date,record);
      if(date===today){result.steps=(result.steps??0)+sample.value;result.lastSteps=Math.max(result.lastSteps??0,end);result.last=Math.max(result.last??0,end);}
    }else if(date===today&&/activeenergy(?:burned)?$/.test(name)){
      const value=unit==="kj"?sample.value/4.184:["kcal","cal","kilocalories"].includes(unit)?sample.value:null;
      if(value!==null){result.energy=(result.energy??0)+value;result.last=Math.max(result.last??0,end);}
    }else if(date===today&&/restingheartrate$/.test(name)&&end>restingAt){
      result.resting=sample.value;restingAt=end;result.last=Math.max(result.last??0,end);
    }
  }
  const dates=[...stepDays.keys()].sort();
  if(dates.length){
    result.recentDay=dates[dates.length-1];
    result.recentSteps=stepDays.get(result.recentDay).count;
  }
  result.status=result.last===null?"no_today":"ok";
  return result;
 }

 root.HealthDetail={oura,appleSummary};
 function render(){
  const page=document.querySelector("[data-health-detail]");if(!page)return;
  const appleNode=page.querySelector('template[data-apple-source="ali"]');
  let samples=null;try{samples=JSON.parse(appleNode?.content?.textContent||"null");}catch{}
  const nowMs=Number(page.dataset.now)*1000;
  const movement=appleSummary(samples,nowMs);
  const retainedNode=page.querySelector("template[data-ali-retained]");
  let retained=null;try{retained=JSON.parse(retainedNode?.content?.textContent||"null");}catch{}
  const isRetained=retained&&typeof retained.date==="string"&&Number.isFinite(retained.count)&&retained.count>=0&&retained.count<200000;
  const nowLocalDay=new Intl.DateTimeFormat("en-CA",{timeZone:"America/Indiana/Indianapolis",year:"numeric",month:"2-digit",day:"2-digit"}).formatToParts(new Date(nowMs));
  const gd=k=>nowLocalDay.find(x=>x.type===k)?.value;
  const todayLocal=gd("year")+"-"+gd("month")+"-"+gd("day");
  const toLabel=date=>{const p=date.split("-").map(Number);return new Intl.DateTimeFormat("en-US",{month:"short",day:"numeric",timeZone:"UTC"}).format(new Date(Date.UTC(p[0],p[1]-1,p[2])));};
  const set=(selector,value)=>{const node=page.querySelector(selector);if(node)node.textContent=value;};
  const fmtTime=ms=>new Intl.DateTimeFormat("en-US",{timeZone:"America/Indiana/Indianapolis",hour:"numeric",minute:"2-digit"}).format(new Date(ms));
  let aliPlotSteps=movement.steps,aliPlotAt=movement.lastSteps;
  if(movement.steps!==null){
    set("[data-ali-steps]",Math.round(movement.steps).toLocaleString("en-US"));
    set("[data-ali-sync]","as of "+fmtTime(movement.lastSteps));
  }else if(isRetained){
    set("[data-ali-steps]",Math.round(retained.count).toLocaleString("en-US"));
    const observed=Date.parse(retained.observed_at||"");
    const timeGood=retained.date===todayLocal&&Number.isFinite(observed)&&observed<=nowMs+300000;
    if(timeGood){aliPlotSteps=retained.count;aliPlotAt=observed;set("[data-ali-sync]","retained "+fmtTime(observed));}
    else{set("[data-ali-sync]","last "+toLabel(retained.date)+" · stale");}
  }else if(movement.recentDay!==null){
    set("[data-ali-steps]",Math.round(movement.recentSteps).toLocaleString("en-US"));
    set("[data-ali-sync]","last "+toLabel(movement.recentDay)+" · stale");
  }else{
    set("[data-ali-steps]","—");
    set("[data-ali-sync]","awaiting Apple Health");
  }
  const chart=page.querySelector("[data-goal-chart]");
  if(chart){
    const scale=Math.max(Number(chart.dataset.scale),aliPlotSteps===null?0:aliPlotSteps*1.08);
    const goal=Number(chart.dataset.goal),bottom=231,height=207;
    if(Number.isFinite(scale)&&scale>0&&Number.isFinite(goal)&&goal>0){
      const stuPoint=chart.querySelector("[data-current-step-point]");
      if(stuPoint){const stu=Number(stuPoint.dataset.steps);if(Number.isFinite(stu))stuPoint.setAttribute("cy",String(bottom-height*stu/scale));}
      const logistic=t=>1/(1+Math.exp(-0.30586*(t-14.9835)));
      const lo=logistic(0),hi=logistic(24);
      const frac=t=>(logistic(t)-lo)/(hi-lo);
      const y=(t,n)=>bottom-height*n*frac(t)/scale;
      const coords=n=>Array.from({length:97},(_,i)=>{const t=i/4;return (40+450*t/24).toFixed(2)+","+y(t,n).toFixed(2)});
      const band=chart.querySelector("[data-pace-band]");
      if(band)band.setAttribute("d","M"+coords(10000).join(" L")+" L"+coords(7000).reverse().join(" L")+" Z");
      for(const n of [7000,8000,9000]){const el=chart.querySelector("[data-pace-"+n+"]");if(el)el.setAttribute("d","M"+coords(n).join(" L"));}
      const curve=chart.querySelector("[data-smooth-pace]");
      if(curve)curve.setAttribute("d","M"+coords(10000).join(" L"));
      for(const n of [7000,8000,9000,10000]){const el=chart.querySelector("[data-label-"+n+"]");if(el)el.setAttribute("y",String(y(24,n)+4));}
      const point=chart.querySelector("[data-ali-step-point]");
      if(point&&aliPlotSteps!==null&&aliPlotAt!==null){
        const localMs=aliPlotAt+Number(page.dataset.offset)*1000;
        const dayMs=((localMs%86400000)+86400000)%86400000;
        const cx=40+450*dayMs/86400000;
        point.setAttribute("cx",String(cx));
        point.setAttribute("cy",String(bottom-height*aliPlotSteps/scale));
        point.setAttribute("visibility","visible");
      }
    }
  }

  const ouraModels={};
  for(const person of ["stuart","ali"]){
    const source=page.querySelector('template[data-oura-source="'+person+'"]');
    const model=oura(source?.content?.textContent||"",Number(page.dataset.now),Number(page.dataset.offset));
    ouraModels[person]=model;
    const status=page.querySelector('[data-oura-person-status="'+person+'"]');
    if(status){
      status.textContent=model.status==="fresh"?"Current":model.status==="stale"&&model.timestamp?"Stale "+model.timestamp:"Unavailable";
    }
  }
  for(const metric of ["Readiness","Sleep","Activity"]){
    const section=page.querySelector('[data-oura-metric="'+metric+'"]');if(!section)continue;
    for(const person of ["stuart","ali"]){
      const row=section.querySelector('[data-oura-score-person="'+person+'"]');if(!row)continue;
      const model=ouraModels[person];
      const n=model?.scores?.[metric];
      const valid=Number.isFinite(n)&&n>=0&&n<=100;
      const value=row.querySelector("[data-oura-score-value]");
      const fill=row.querySelector("[data-oura-score-fill]");
      if(value)value.textContent=valid?String(n):"—";
      if(fill){
        fill.style.width=valid?n+"%":"0%";
        fill.style.opacity=model.status==="stale"?"0.55":"1";
      }
      row.style.opacity=model.status==="stale"?"0.7":"1";
    }
  }
 }
 if(typeof document!=="undefined"){if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",render,{once:true});else render();}
})(typeof window!=="undefined"?window:globalThis);
/* HealthDetail:end */
</script>
