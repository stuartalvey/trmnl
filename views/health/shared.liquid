{% template recovery_person %}
<div class="flex flex--col gap--xsmall bg--gray-75 rounded--large p--2 w--full" data-person="{{ person }}">
 <div class="flex flex--row flex--between w--full"><span class="title title--small">{{ name }}</span><span class="label label--small label--gray" data-oura-status>Sync Oura</span></div>
 <div class="flex flex--row flex--between w--full">
 {% assign names = 'Readiness,Sleep,Activity' | split: ',' %}{% for name in names %}
  <div class="flex flex--col flex--center-x gap--xsmall" data-score="{{ name }}">
   <svg class="w--14 h--14" viewBox="0 0 60 60" role="img" aria-label="{{ name }} score">
    <circle cx="30" cy="30" r="24" fill="none" stroke="#ccc" stroke-width="5"/>
    <circle cx="30" cy="30" r="24" fill="none" stroke="black" stroke-width="5" pathLength="100" stroke-dasharray="0 100" transform="rotate(-90 30 30)" data-arc/>
    <text x="30" y="37" text-anchor="middle" font-family="sans-serif" font-size="22" data-number>—</text>
   </svg>
   <span class="label label--small">{{ name }}</span>
  </div>
 {% endfor %}
 </div>
</div>
{% endtemplate %}
<script>
/* HealthDetail:start */
(function(root){
 const MAX_AGE_MINUTES=360;
 const MONTHS={jan:0,feb:1,mar:2,apr:3,may:4,jun:5,jul:6,aug:7,sep:8,oct:9,nov:10,dec:11};
   function parseSnapshot(markup, nowSeconds, utcOffsetSeconds) {
    if (typeof markup !== "string" || !markup.trim()) return { status: "missing", score: null };
    // The third-party Oura plugin currently exposes rendered markup, not raw scores.
    // Match only the numeric value immediately followed by its Readiness label.
    var scoreMatch = markup.match(/<span\b[^>]*class=["'][^"']*\bvalue\b[^"']*["'][^>]*>\s*(\d{1,3})\s*<\/span>\s*<span\b[^>]*>\s*Readiness\s*<\/span>/i);
    if (!scoreMatch) return { status: "missing", score: null };
    var score = Number(scoreMatch[1]);
    if (!Number.isInteger(score) || score < 0 || score > 100) return { status: "invalid", score: null };
    var updated = markup.match(/Last\s+updated:\s*(\d{1,2})\s+([A-Za-z]{3,9})\s+(\d{1,2}):(\d{2})(?:\s*(AM|PM))?/i);
    if (!updated || !Number.isFinite(nowSeconds) || !Number.isFinite(utcOffsetSeconds)) return { status: "undated", score: score };
    var month = MONTHS[updated[2].slice(0, 3).toLowerCase()];
    var day = Number(updated[1]);
    var hour = Number(updated[3]);
    var minute = Number(updated[4]);
    if (updated[5]) {
      if (hour < 1 || hour > 12) return { status: "undated", score: score };
      hour = hour % 12 + (updated[5].toLowerCase() === "pm" ? 12 : 0);
    }
    if (month === undefined || day < 1 || day > 31 || hour < 0 || hour > 23 || minute < 0 || minute > 59) return { status: "undated", score: score };
    var localNow = new Date((nowSeconds + utcOffsetSeconds) * 1000);
    if (month !== localNow.getUTCMonth() || day !== localNow.getUTCDate()) return { status: "stale", score: score };
    var updatedMs = Date.UTC(localNow.getUTCFullYear(), month, day, hour, minute);
    var ageMinutes = (localNow.getTime() - updatedMs) / 60000;
    if (ageMinutes > MAX_AGE_MINUTES || ageMinutes < -5) return { status: "stale", score: score };
    return { status: "fresh", score: score };
  }

 function oura(markup,now,offset){
  const freshness=parseSnapshot(markup,now,offset),scores={Readiness:null,Sleep:null,Activity:null};
  if(freshness.status==="fresh"){
   const re=/<span\b[^>]*class=["'][^"']*\bvalue\b[^"']*["'][^>]*>\s*(\d{1,3})\s*<\/span>\s*<span\b[^>]*>\s*(Readiness|Sleep|Activity)\s*<\/span>/gi;
   for(const m of markup.matchAll(re)){const n=Number(m[1]),name=Object.keys(scores).find(k=>k.toLowerCase()===m[2].toLowerCase());if(n>=0&&n<=100)scores[name]=n;}
  }
  return {status:freshness.status,scores};
 }

 function appleSummary(samples,nowMs){
  const result={steps:null,energy:null,resting:null,last:null,status:"missing"};
  if(!Array.isArray(samples))return result;
  const day=v=>{const p=new Intl.DateTimeFormat("en-US",{timeZone:"America/Indiana/Indianapolis",year:"numeric",month:"2-digit",day:"2-digit"}).formatToParts(new Date(v));const g=k=>p.find(x=>x.type===k).value;return g("year")+"-"+g("month")+"-"+g("day");};
  const today=day(nowMs),seen=new Set();let restingAt=-Infinity;
  for(const sample of samples){
   if(!sample||typeof sample.value!=="number"||!Number.isFinite(sample.value)||sample.value<0)continue;
   const start=Date.parse(sample.start_date),end=Date.parse(sample.end_date);
   if(!Number.isFinite(start)||!Number.isFinite(end)||end<start||end>nowMs+300000||day(start)!==today)continue;
   const name=String(sample.metric_type||"").toLowerCase().replace(/[^a-z]/g,""),unit=String(sample.unit||"").toLowerCase();
   const key=[name,unit,start,end,sample.value].join("|");if(seen.has(key))continue;seen.add(key);
   if(/(?:stepcount|steps)$/.test(name)){result.steps=(result.steps??0)+sample.value;result.last=Math.max(result.last??0,end);}
   else if(/activeenergy(?:burned)?$/.test(name)){
    const value=unit==="kj"?sample.value/4.184:["kcal","cal","kilocalories"].includes(unit)?sample.value:null;
    if(value!==null){result.energy=(result.energy??0)+value;result.last=Math.max(result.last??0,end);}
   }else if(/restingheartrate$/.test(name)&&end>restingAt){result.resting=sample.value;restingAt=end;result.last=Math.max(result.last??0,end);}
  }
  result.status=result.last===null?"no_today":"ok";return result;
 }

 root.HealthDetail={oura,appleSummary};
 function render(){
  const page=document.querySelector("[data-health-detail]");if(!page)return;
  const appleNode=page.querySelector('template[data-apple-source="ali"]');
  let samples=null;try{samples=JSON.parse(appleNode?.content?.textContent||"null");}catch{}
  const movement=appleSummary(samples,Number(page.dataset.now)*1000);
  const set=(selector,value)=>{const node=page.querySelector(selector);if(node)node.textContent=value;};
  set("[data-ali-steps]",movement.steps===null?"—":String(Math.round(movement.steps)));
  set("[data-ali-card-steps]",movement.steps===null?"—":String(Math.round(movement.steps)));
  const chart=page.querySelector("[data-goal-chart]");
  if(chart){
    const scale=Math.max(Number(chart.dataset.scale),movement.steps===null?0:movement.steps*1.1),goal=Number(chart.dataset.goal);
    if(Number.isFinite(scale)&&scale>0&&Number.isFinite(goal)&&goal>0){
      // Grow the y-axis when Ali is ahead of the current goal or Stuart's count.
      const goalLine=chart.querySelector('line[stroke-dasharray="5 4"]');
      if(goalLine)goalLine.setAttribute("y1",String(120-105*goal/scale)),goalLine.setAttribute("y2",String(120-105*goal/scale));
      const stuPoint=chart.querySelector("[data-current-step-point]");
      if(stuPoint){
        const stuSteps=Number(stuPoint.dataset.steps);
        if(Number.isFinite(stuSteps))stuPoint.setAttribute("cy",String(120-105*stuSteps/scale));
      }
      const logistic=t=>1/(1+Math.exp(-0.30586*(t-14.9835)));
      const lo=logistic(0),hi=logistic(24);
      const frac=t=>(logistic(t)-lo)/(hi-lo);
      const y=t=>120-105*goal*frac(t)/scale;
      const slope=t=>{const z=logistic(t);return -105*goal/scale*0.30586*z*(1-z)/(hi-lo);};
      // Cubic Hermite segments for a continuously smooth fitted trend.
      const d=["M40 120"];
      for(let i=0;i<96;i++){
        const t=i/4,x0=40+456*t/24,x1=40+456*(t+0.25)/24,dx=x1-x0;
        d.push("C"+(x0+dx/3).toFixed(2)+","+(y(t)+slope(t)/12).toFixed(2)+" "+(x1-dx/3).toFixed(2)+","+(y(t+0.25)-slope(t+0.25)/12).toFixed(2)+" "+x1.toFixed(2)+","+y(t+0.25).toFixed(2));
      }
      const curve=chart.querySelector("[data-smooth-pace]");
      if(curve)curve.setAttribute("d",d.join(" "));
      const point=chart.querySelector("[data-ali-step-point]");
      if(point&&movement.steps!==null){
        const prior=chart.querySelector("[data-current-step-point]");
        const localSeconds=(Number(page.dataset.now)+Number(page.dataset.offset))%86400;
        const cx=prior?Number(prior.getAttribute("cx")):40+456*((localSeconds+86400)%86400)/86400;
        point.setAttribute("cx",String(cx));
        point.setAttribute("cy",String(120-105*movement.steps/scale));
        point.setAttribute("visibility","visible");
      }
    }
  }
  set("[data-ali-secondary]",movement.status==="ok"?(movement.energy===null?"Energy —":Math.round(movement.energy)+" kcal")+" · RHR: "+(movement.resting===null?"—":Math.round(movement.resting)+" bpm"):"No current-day samples");
  set("[data-ali-sync]",movement.last===null?"Apple Health · awaiting current-day data":"Apple Health · as of "+new Intl.DateTimeFormat("en-US",{timeZone:"America/Indiana/Indianapolis",hour:"numeric",minute:"2-digit"}).format(new Date(movement.last)));
  for(const person of ["stuart","ali"]){
   const source=page.querySelector('template[data-oura-source="'+person+'"]');
   const model=oura(source?.content?.textContent||"",Number(page.dataset.now),Number(page.dataset.offset));
   const panel=page.querySelector('[data-person="'+person+'"]');if(!panel)continue;
   panel.querySelector("[data-oura-status]").textContent=model.status==="fresh"?"Current snapshot":"Sync Oura";
   for(const name of Object.keys(model.scores)){
    const gauge=panel.querySelector('[data-score="'+name+'"]'),n=model.scores[name];if(!gauge)continue;
    gauge.querySelector("[data-number]").textContent=n===null?"—":String(n);
    gauge.querySelector("[data-arc]").setAttribute("stroke-dasharray",n===null?"0 100":n+" "+(100-n));
   }
  }
 }
 if(typeof document!=="undefined"){if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",render,{once:true});else render();}
})(typeof window!=="undefined"?window:globalThis);
/* HealthDetail:end */
</script>
