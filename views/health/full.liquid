{% assign health = private_plugin_536212.merge_variables %}
{% assign training = private_plugin_536353.merge_variables %}
{% assign now_ts = trmnl.system.timestamp_utc | plus: 0 %}
{% assign local_now = now_ts | plus: trmnl.user.utc_offset %}
{% assign today = local_now | date: '%Y-%m-%d' %}
{% assign goal = trmnl.plugin_settings.custom_fields_values.step_goal | default: 10000 | plus: 0 | at_least: 1 %}
{% assign today_record = nil %}{% assign prior_sum = 0 %}{% assign prior_count = 0 %}{% assign chart_max = goal %}
{% for entry in health.daily_history %}
 {% if entry.date == today %}{% assign today_record = entry %}{% endif %}
 {% if entry.m.step_count != nil %}{% if entry.m.step_count > chart_max %}{% assign chart_max = entry.m.step_count %}{% endif %}{% if entry.date < today %}{% assign prior_sum = prior_sum | plus: entry.m.step_count %}{% assign prior_count = prior_count | plus: 1 %}{% endif %}{% endif %}
{% endfor %}
{% assign scale_max = chart_max | times: 1.15 %}
{% assign goal_y = goal | times: 105.0 | divided_by: scale_max %}{% assign goal_y = 120 | minus: goal_y %}
<div class="layout layout--col layout--top gap--medium" data-health-detail data-now="{{ now_ts }}" data-offset="{{ trmnl.user.utc_offset }}">
  <div class="flex flex--row flex--between flex--center-y w--full">
    <span class="title title--large lg:title--xxlarge">Alvey Health</span>
    <div class="flex flex--col flex--right gap--xsmall"><span class="label">{{ local_now | date: '%A, %B %-d' }}</span><span class="label label--small label--gray">Movement · Recovery · Consistency</span></div>
  </div>
  <div class="grid grid--cols-12 gap--medium w--full">
    <div class="col--span-7 flex flex--col gap--small outline outline--muted rounded--large p--3">
      <div class="flex flex--row flex--between w--full"><span class="title">Stuart · Daily movement</span><span class="label label--small label--gray">{% if health.updated_at %}{% assign sync_ts = health.updated_at | date: '%s' | plus: trmnl.user.utc_offset %}Synced {{ sync_ts | date: '%b %-d, %-I:%M %p' }}{% else %}Awaiting Apple Health{% endif %}</span></div>
      <div class="flex flex--row flex--between flex--center-y w--full">
        <div class="flex flex--col gap--xsmall"><span class="value value--large">{% if today_record.m.step_count != nil %}{{ today_record.m.step_count | round }}{% else %}—{% endif %}</span><span class="label label--small label--gray">Steps today · Goal {{ goal }}</span></div>
        <div class="flex flex--col gap--xsmall flex--right">
          <span class="label label--small">Active energy {% if today_record.m.active_energy != nil %}{{ today_record.m.active_energy | round }} kcal{% else %}—{% endif %}</span>
          <span class="label label--small">Resting HR {% if today_record.m.resting_heart_rate != nil %}{{ today_record.m.resting_heart_rate | round }} bpm{% else %}—{% endif %}</span>
        </div>
      </div>
      <svg class="w--full h--36" viewBox="0 0 520 150" preserveAspectRatio="none" role="img" aria-label="Last seven daily step totals and adjustable goal; missing days are dashes">
        <line x1="0" y1="{{ goal_y }}" x2="520" y2="{{ goal_y }}" stroke="black" stroke-dasharray="4 4"/>
        {% if prior_count > 0 %}{% assign average = prior_sum | divided_by: prior_count %}{% assign average_y = average | times: 105.0 | divided_by: scale_max %}{% assign average_y = 120 | minus: average_y %}<line x1="0" y1="{{ average_y }}" x2="520" y2="{{ average_y }}" stroke="#888" stroke-width="1.5"/>{% endif %}
        {% for i in (0..6) %}
          {% assign back = 6 | minus: i | times: 86400 %}{% assign stamp = local_now | minus: back %}{% assign date = stamp | date: '%Y-%m-%d' %}
          {% assign record = nil %}{% for entry in health.daily_history %}{% if entry.date == date %}{% assign record = entry %}{% endif %}{% endfor %}
          {% assign x = i | times: 74 | plus: 37 %}
          {% if record.m.step_count != nil %}{% assign h = record.m.step_count | times: 105.0 | divided_by: scale_max %}{% assign y = 120 | minus: h %}
            <rect data-step-day="{{ date }}" x="{{ x | minus: 18 }}" y="{{ y }}" width="36" height="{{ h }}" rx="4" fill="{% if date == today %}black{% else %}#aaa{% endif %}"/>
          {% else %}<text x="{{ x }}" y="117" text-anchor="middle" font-size="16" fill="#888">—</text>{% endif %}
          <text x="{{ x }}" y="144" text-anchor="middle" font-size="13" fill="#666">{{ stamp | date: '%a' }}</text>
        {% endfor %}
      </svg>
      <div class="flex flex--row flex--between w--full"><span class="label label--small label--gray">Dashed: goal · Solid gray: prior-day average</span><span class="label label--small label--gray">{% if prior_count > 0 %}{{ prior_count }} prior days{% else %}Building history{% endif %}</span></div>
      <span class="label label--small label--gray">Daily totals available · hourly comparison needs hourly samples</span>
    </div>

    <div class="col--span-5 flex flex--col gap--small outline outline--muted rounded--large p--3">
      <div class="flex flex--row flex--between w--full"><span class="title">Recovery</span><span class="label label--small label--gray">Oura scores / 100</span></div>
      {% render "recovery_person", person: 'stuart', name: 'Stuart' %}
      {% render "recovery_person", person: 'ali', name: 'Ali' %}
      <span class="label label--small label--gray">Ali’s Apple Health: not connected yet</span>
      <template data-oura-source="stuart">{{ oura_536089.markup_full | escape }}</template>
      <template data-oura-source="ali">{{ oura_536097.markup_full | escape }}</template>
    </div>
  </div>

  <div class="flex flex--col gap--small outline outline--muted rounded--large p--3 w--full">
    <div class="flex flex--row flex--between w--full"><span class="title">Workout consistency</span><span class="label label--small label--gray">Protein Social · 8 weeks · logged workouts</span></div>
    {% if training.status == 'ok' or training.status == 'partial' %}
    <div class="grid grid--cols-12 gap--medium w--full">
      <div class="col--span-6 flex flex--col gap--small">
        <div class="flex flex--row gap--medium flex--center-y w--full">
          <div class="flex flex--col gap--xsmall"><span class="value value--medium">{{ training.this_week }}</span><span class="label label--small label--gray">This week</span></div>
          <div class="flex flex--col gap--xsmall"><span class="value value--medium">{{ training.last_week }}</span><span class="label label--small label--gray">Last week</span></div>
          <div class="flex flex--col gap--xsmall"><span class="value value--medium">{{ training.active_days }}</span><span class="label label--small label--gray">Active days / 8 wk</span></div>
        </div>
        <div class="flex flex--row gap--xsmall flex--center-x w--full">
          <div class="flex flex--col gap--xsmall">{% assign weekdays = 'M,T,W,T,F,S,S' | split: ',' %}{% for letter in weekdays %}<div class="w--4 h--4 flex flex--center-x flex--center-y"><span class="label label--small label--gray">{{ letter }}</span></div>{% endfor %}</div>
          {% for week in training.weeks %}
          <div class="flex flex--col gap--xsmall">
            {% for cell in week.cells %}
            <div class="w--4 h--4 rounded--small {% if cell.count > 0 %}bg--black{% elsif cell.future %}outline outline--muted{% elsif cell.known %}bg--gray-75{% else %}outline outline--muted{% endif %}" title="{{ cell.date }} · {{ cell.count }} logged sessions"></div>
            {% endfor %}
          </div>{% endfor %}
        </div>
      </div>
      <div class="col--span-6 flex flex--col gap--small">
        <span class="label label--small label--gray">COMPLETED SESSIONS BY WEEK</span>
        {% assign max_week = 1 %}{% for week in training.weeks %}{% if week.count > max_week %}{% assign max_week = week.count %}{% endif %}{% endfor %}
        <svg class="w--full h--40" viewBox="0 0 450 160" role="img" aria-label="Eight weekly totals of completed workouts">
          {% for week in training.weeks %}{% assign x = forloop.index0 | times: 56 | plus: 28 %}{% assign h = week.count | times: 95.0 | divided_by: max_week %}{% assign y = 120 | minus: h %}
          <rect x="{{ x | minus: 16 }}" y="{{ y }}" width="32" height="{{ h }}" rx="4" fill="{% if forloop.last %}black{% else %}#aaa{% endif %}"/>
          <text x="{{ x }}" y="{{ y | minus: 6 }}" text-anchor="middle" font-size="15">{{ week.count }}</text>
          <text x="{{ x }}" y="144" text-anchor="middle" font-size="11" fill="#666">{{ week.start | date: '%b %-d' }}</text>
          {% endfor %}
        </svg>
      </div>
    </div>
    <span class="label label--small label--gray w--full text--left">Black: workout logged · Gray: none logged · Outline: future / unknown{% if training.status == 'partial' %} · Feed incomplete{% endif %}</span>
    {% else %}<span class="label label--gray">Workout history unavailable · Apple Health and Oura remain independent</span>{% endif %}
  </div>
</div>
<div class="title_bar"><span class="title">Health Detail · First draft</span><span class="instance">Apple Health · Oura · Protein Social · Snapshots · ET</span></div>
