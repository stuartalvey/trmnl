{% assign health = private_plugin_536212.merge_variables %}
{% assign training = private_plugin_536353.merge_variables %}
{% assign now_ts = trmnl.system.timestamp_utc | plus: 0 %}
{% assign local_now = now_ts | plus: trmnl.user.utc_offset %}
{% assign today = local_now | date: '%Y-%m-%d' %}
{% assign goal = trmnl.plugin_settings.custom_fields_values.step_goal | default: 10000 | plus: 0 | at_least: 1 %}
{% assign today_record = nil %}
{% assign latest_record = nil %}{% assign latest_day = '' %}
{% for entry in health.daily_history %}
  {% if entry.m.step_count != nil %}
    {% if entry.date == today %}{% assign today_record = entry %}{% endif %}
    {% if latest_day == '' or entry.date > latest_day %}{% assign latest_record = entry %}{% assign latest_day = entry.date %}{% endif %}
  {% endif %}
{% endfor %}
{% comment %}Personalized pace = bounded sigmoid fit to 31 complete Indianapolis-local days of Stuart's historical Apple Health step data. It is a goal trajectory, not either person's observed intraday history.{% endcomment %}
{% assign scale_max = goal %}
{% if today_record.m.step_count > scale_max %}{% assign scale_max = today_record.m.step_count %}{% endif %}
{% assign scale_max = scale_max | times: 1.1 %}
{% assign goal_height = goal | times: 146.0 | divided_by: scale_max %}
{% assign goal_y = 176 | minus: goal_height %}
{% assign stu_sample_local = local_now %}
{% if health.updated_at %}
  {% assign stu_sample_local = health.updated_at | date: '%s' | plus: trmnl.user.utc_offset %}
  {% assign stu_sample_day = stu_sample_local | date: '%Y-%m-%d' %}
  {% if stu_sample_day != today %}{% assign stu_sample_local = local_now %}{% endif %}
{% endif %}
{% assign stu_hour = stu_sample_local | date: '%H' | plus: 0 %}
{% assign stu_minute = stu_sample_local | date: '%M' | plus: 0 %}
{% assign stu_elapsed_minutes = stu_hour | times: 60 | plus: stu_minute %}
{% assign stu_point_x = stu_elapsed_minutes | times: 456.0 | divided_by: 1440 | plus: 40 %}
{% assign stu_point_height = today_record.m.step_count | times: 146.0 | divided_by: scale_max %}
{% assign stu_point_y = 176 | minus: stu_point_height %}
<div class="layout layout--col layout--top gap--medium" data-health-detail data-now="{{ now_ts }}" data-offset="{{ trmnl.user.utc_offset }}">
  <div class="flex flex--row flex--between flex--center-y w--full">
    <span class="title title--large lg:title--xxlarge">Alvey Health</span>
    <div class="flex flex--col flex--right gap--xsmall"><span class="label">{{ local_now | date: '%A, %B %-d' }}</span><span class="label label--small label--gray">Movement · Recovery · Consistency</span></div>
  </div>
  <div class="grid grid--cols-12 gap--medium w--full">
    <div class="col--span-7 flex flex--col gap--small outline outline--muted rounded--large p--3">
      <div class="flex flex--row flex--between flex--center-y w--full">
        <span class="title">Daily steps · Stuart + Ali</span>
        <span class="label label--small label--gray">Goal reference: {{ goal | round }} steps</span>
      </div>
      <div class="grid grid--cols-2 gap--medium w--full">
        <div class="flex flex--col gap--xsmall">
          <span class="label label--small">● Stuart</span>
          <span class="value value--medium">{% if today_record.m.step_count != nil %}{{ today_record.m.step_count | round }}{% else %}—{% endif %}</span>
          <span class="label label--small label--gray">{% if today_record.m.step_count != nil %}Today · synced {{ stu_sample_local | date: '%-I:%M %p' }}{% elsif latest_record.m.step_count != nil %}Last {{ latest_record.date | date: '%b %-d' }}: {{ latest_record.m.step_count | round }}{% else %}Awaiting Apple Health{% endif %}</span>
        </div>
        <div class="flex flex--col gap--xsmall">
          <span class="label label--small">○ Ali</span>
          <span class="value value--medium" data-ali-steps>—</span>
          <span class="label label--small label--gray" data-ali-sync>Checking Apple Health data</span>
        </div>
      </div>
      <svg class="w--full h--48" viewBox="0 0 520 216" preserveAspectRatio="none" role="img" aria-label="Stuart's personalized goal pace and separate Stuart and Ali step snapshots" data-goal-chart data-scale="{{ scale_max }}" data-goal="{{ goal }}">
        <line x1="40" y1="176" x2="496" y2="176" stroke="#aaa" stroke-width="1"/>
        <line x1="40" y1="{{ goal_y }}" x2="496" y2="{{ goal_y }}" stroke="#888" stroke-width="1.6" stroke-dasharray="5 4" data-goal-line/>
        <path data-smooth-pace fill="none" stroke="black" stroke-width="3" stroke-linecap="round" d="M40 176"/>
        {% if today_record.m.step_count != nil %}
          <line x1="{{ stu_point_x }}" y1="12" x2="{{ stu_point_x }}" y2="176" stroke="#aaa" stroke-width="1" stroke-dasharray="2 4" data-stu-time/>
          <circle cx="{{ stu_point_x }}" cy="{{ stu_point_y }}" r="6" fill="black" stroke="white" stroke-width="2" data-current-step-point data-steps="{{ today_record.m.step_count }}"/>
        {% endif %}
        <circle data-ali-step-point cx="40" cy="176" r="6" fill="white" stroke="black" stroke-width="2.4" visibility="hidden"/>
        {% for hour in (0..4) %}{% assign hx = hour | times: 114 | plus: 40 %}<text x="{{ hx }}" y="202" font-size="13" fill="#666" text-anchor="middle">{% case hour %}{% when 0 %}12 AM{% when 1 %}6 AM{% when 2 %}12 PM{% when 3 %}6 PM{% when 4 %}12 AM{% endcase %}</text>{% endfor %}
      </svg>
      <div class="flex flex--row flex--between w--full">
        <span class="label label--small label--gray">Curve: goal pace · Dashed: goal · ● Stu · ○ Ali</span>
        <span class="label label--small label--gray">{% if today_record.m.step_count != nil %}Stuart: current-day snapshot{% else %}Awaiting today's step sync{% endif %}</span>
      </div>
      <div class="flex flex--row flex--between w--full">
        <span class="label label--small label--gray" data-ali-secondary>Ali: awaiting today's steps</span>
        <span class="label label--small label--gray">{% if today_record.m.active_energy != nil %}Stu: {{ today_record.m.active_energy | round }} kcal{% endif %}{% if today_record.m.resting_heart_rate != nil %} · RHR {{ today_record.m.resting_heart_rate | round }} bpm{% endif %}</span>
      </div>
      <template data-apple-source="ali">{{ private_plugin_536547.merge_variables.health.metrics | json | escape }}</template>
    </div>

    <div class="col--span-5 flex flex--col gap--small outline outline--muted rounded--large p--3">
      <div class="flex flex--row flex--between w--full"><span class="title">Recovery</span><span class="label label--small label--gray">Oura scores / 100</span></div>
      {% render "recovery_person", person: 'stuart', name: 'Stuart' %}
      {% render "recovery_person", person: 'ali', name: 'Ali' %}
      <span class="label label--small label--gray">Apple Health: Stuart + Ali · Oura: both accounts</span>
      <template data-oura-source="stuart">{{ oura_536089.markup_full | escape }}</template>
      <template data-oura-source="ali">{{ oura_536097.markup_full | escape }}</template>
    </div>
  </div>

  <div class="flex flex--col gap--medium outline outline--muted rounded--large p--3 w--full">
    <div class="flex flex--row flex--between flex--center-y w--full">
      <span class="title">Workout consistency</span>
      <span class="label label--small label--gray">Protein Social · last 8 weeks</span>
    </div>
    {% if training.status == 'ok' or training.status == 'partial' %}
      <div class="flex flex--row flex--between flex--center-y w--full">
        <div class="flex flex--row gap--small flex--center-y">
          <span class="value value--large">{{ training.active_days }}</span>
          <div class="flex flex--col gap--xsmall">
            <span class="label">Workout days</span>
            <span class="label label--small label--gray">Last 8 weeks</span>
          </div>
        </div>
        <div class="flex flex--row gap--large flex--center-y">
          <div class="flex flex--col gap--xsmall">
            <span class="value value--medium">{{ training.this_week }}</span>
            <span class="label label--small label--gray">This week</span>
          </div>
          <div class="flex flex--col gap--xsmall">
            <span class="value value--medium">{{ training.last_week }}</span>
            <span class="label label--small label--gray">Last week</span>
          </div>
        </div>
      </div>
      {% assign max_week = 4 %}
      {% for week in training.weeks %}{% if week.count > max_week %}{% assign max_week = week.count %}{% endif %}{% endfor %}
      <svg class="w--full h--44" viewBox="0 0 860 178" preserveAspectRatio="none" role="img" aria-label="Weekly count of workout days. Completed and partial workouts count equally.">
        <line x1="30" y1="137" x2="830" y2="137" stroke="#999" stroke-width="1"/>
        {% for week in training.weeks %}
          {% assign x = forloop.index0 | times: 101 | plus: 72 %}
          {% assign h = week.count | times: 112.0 | divided_by: max_week %}
          {% assign y = 137 | minus: h %}
          {% if week.count > 0 %}<rect x="{{ x | minus: 24 }}" y="{{ y }}" width="48" height="{{ h }}" rx="4" fill="{% if forloop.last %}black{% else %}#aaa{% endif %}"/>{% endif %}
          <text x="{{ x }}" y="{{ y | minus: 6 }}" text-anchor="middle" font-size="18" fill="black">{{ week.count }}</text>
          <text x="{{ x }}" y="159" text-anchor="middle" font-size="16" fill="#666">{{ week.start | date: '%b %-d' }}</text>
        {% endfor %}
      </svg>
      <span class="label label--small label--gray w--full">Each day with a logged workout counts once. Completed and partial sessions count identically.{% if training.status == 'partial' %} · History may be incomplete{% endif %}</span>
    {% else %}
      <span class="label label--gray">Workout history unavailable</span>
    {% endif %}
  </div>
</div>
<div class="title_bar"><span class="title">Health Detail · Daily movement + consistency</span><span class="instance">Apple Health · Oura · Protein Social · Snapshots · ET</span></div>
