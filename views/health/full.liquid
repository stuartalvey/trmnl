{% assign health = private_plugin_536212.merge_variables %}
{% assign training = private_plugin_536353.merge_variables %}
{% assign now_ts = trmnl.system.timestamp_utc | plus: 0 %}
{% assign local_now = now_ts | plus: trmnl.user.utc_offset %}
{% assign today = local_now | date: '%Y-%m-%d' %}
{% assign goal = trmnl.plugin_settings.custom_fields_values.step_goal | default: 10000 | plus: 0 | at_least: 1 %}
{% assign today_record = nil %}{% assign prior_sum = 0 %}{% assign prior_count = 0 %}{% assign chart_max = goal %}
{% for entry in health.daily_history %}
 {% if entry.date == today %}{% assign today_record = entry %}{% endif %}
 {% if entry.m.step_count != nil %}{% if entry.m.step_count > chart_max %}{% assign chart_max = entry.m.step_count %}{% endif %}{% if entry.date < today %}{% assign prior_sum = prior_sum | plus: entry.m.step_count %}{% assign prior_count = prior_count | plus: 1 %}{% endif %}{% endif %}
{% endfor %}
{% comment %}Personalized smooth S-curve is a two-parameter normalized sigmoid least-squares fit to 31 daily cumulative Apple Health step curves (k=0.30586, midpoint=14.9835 hours). Aggregate fit only; not Ali-specific.{% endcomment %}
{% assign pace_curve = '0,0.0038,0.0090,0.0159,0.0252,0.0376,0.0539,0.0752,0.1027,0.1377,0.1814,0.2345,0.2971,0.3684,0.4464,0.5280,0.6095,0.6873,0.7584,0.8207,0.8735,0.9168,0.9516,0.9789,1.0' | split: ',' %}
{% assign current_hour = local_now | date: '%H' | plus: 0 %}
{% assign current_minute = local_now | date: '%M' | plus: 0 %}
{% assign elapsed_minutes = current_hour | times: 60 | plus: current_minute %}
{% assign pace_prev = pace_curve[current_hour] | plus: 0 %}
{% assign pace_next_idx = current_hour | plus: 1 %}
{% assign pace_next = pace_curve[pace_next_idx] | plus: 0 %}
{% assign pace_delta = pace_next | minus: pace_prev %}
{% assign pace_fraction = pace_delta | times: current_minute | divided_by: 60.0 | plus: pace_prev %}
{% assign target_now = goal | times: pace_fraction | round %}
{% assign scale_max = goal %}
{% if today_record.m.step_count > scale_max %}{% assign scale_max = today_record.m.step_count %}{% endif %}
{% assign scale_max = scale_max | times: 1.1 %}
{% assign goal_y = goal | times: 105.0 | divided_by: scale_max %}{% assign goal_y = 120 | minus: goal_y %}
{% assign point_x = elapsed_minutes | times: 456.0 | divided_by: 1440 | plus: 40 %}
{% assign point_y = today_record.m.step_count | times: 105.0 | divided_by: scale_max %}{% assign point_y = 120 | minus: point_y %}
<div class="layout layout--col layout--top gap--medium" data-health-detail data-now="{{ now_ts }}" data-offset="{{ trmnl.user.utc_offset }}">
  <div class="flex flex--row flex--between flex--center-y w--full">
    <span class="title title--large lg:title--xxlarge">Alvey Health</span>
    <div class="flex flex--col flex--right gap--xsmall"><span class="label">{{ local_now | date: '%A, %B %-d' }}</span><span class="label label--small label--gray">Movement · Recovery · Consistency</span></div>
  </div>
  <div class="grid grid--cols-12 gap--medium w--full">
    <div class="col--span-7 flex flex--col gap--small outline outline--muted rounded--large p--3">
      <div class="flex flex--row flex--between w--full"><span class="title">Daily movement · Stuart + Ali</span><span class="label label--small label--gray">{% if health.updated_at %}{% assign sync_ts = health.updated_at | date: '%s' | plus: trmnl.user.utc_offset %}Stu synced {{ sync_ts | date: '%b %-d, %-I:%M %p' }}{% else %}Awaiting Apple Health{% endif %}</span></div>
      <div class="flex flex--row flex--between flex--center-y w--full">
        <div class="flex flex--col gap--xsmall"><span class="value value--large">{% if today_record.m.step_count != nil %}{{ today_record.m.step_count | round }}{% else %}—{% endif %}</span><span class="label label--small label--gray">Stuart steps today · Goal {{ goal }}</span></div>
        <div class="flex flex--col gap--xsmall flex--right">
          <span class="label label--small">Active energy {% if today_record.m.active_energy != nil %}{{ today_record.m.active_energy | round }} kcal{% else %}—{% endif %}</span>
          <span class="label label--small">Resting HR {% if today_record.m.resting_heart_rate != nil %}{{ today_record.m.resting_heart_rate | round }} bpm{% else %}—{% endif %}</span>
        </div>
      </div>
      <div class="flex flex--row flex--between w--full">
        <div class="flex flex--col gap--xsmall"><span class="label label--small label--gray">Stuart</span><span class="title title--medium">{% if today_record.m.step_count != nil %}{{ today_record.m.step_count | round }}{% else %}—{% endif %}</span></div>
        <div class="flex flex--col gap--xsmall"><span class="label label--small label--gray">Ali</span><span class="title title--medium" data-ali-steps>—</span></div>
        <div class="flex flex--col gap--xsmall"><span class="label label--small label--gray">Daily goal</span><span class="title title--medium">{{ goal }}</span></div>
      </div>
      <svg class="w--full h--28" viewBox="0 0 520 150" preserveAspectRatio="none" role="img" aria-label="Smooth personalized goal pace with Stuart and Ali step snapshots" data-goal-chart data-scale="{{ scale_max }}" data-goal="{{ goal }}">
        <line x1="40" y1="120" x2="496" y2="120" stroke="#aaa" stroke-width="1"/>
        <line x1="40" y1="{{ goal_y }}" x2="496" y2="{{ goal_y }}" stroke="#888" stroke-width="1.5" stroke-dasharray="5 4"/>
        <path data-smooth-pace fill="none" stroke="black" stroke-width="3" stroke-linecap="round" d="M40 120" />
        {% if today_record.m.step_count != nil %}
          <line x1="{{ point_x }}" y1="10" x2="{{ point_x }}" y2="120" stroke="#aaa" stroke-width="1" stroke-dasharray="2 4"/>
          <circle cx="{{ point_x }}" cy="{{ point_y }}" r="6" fill="black" stroke="white" stroke-width="2" data-current-step-point data-steps="{{ today_record.m.step_count }}"/>
        {% endif %}
        <circle data-ali-step-point cx="{{ point_x }}" cy="120" r="6" fill="white" stroke="black" stroke-width="2.4" visibility="hidden"/>
        {% for hour in (0..4) %}{% assign hx = hour | times: 114 | plus: 40 %}<text x="{{ hx }}" y="140" font-size="12" fill="#666" text-anchor="middle">{% case hour %}{% when 0 %}12a{% when 1 %}6a{% when 2 %}12p{% when 3 %}6p{% when 4 %}12a{% endcase %}</text>{% endfor %}
      </svg>
      <div class="flex flex--row flex--between w--full"><span class="label label--small label--gray">Curve: fitted goal pace · Dashed: goal · ● Stuart · ○ Ali</span><span class="label label--small label--gray">{% if today_record.m.step_count != nil %}{% assign diff = today_record.m.step_count | minus: target_now %}{% if diff >= 0 %}{{ diff | round }} ahead{% else %}{{ diff | abs | round }} behind{% endif %}{% else %}Awaiting today's steps{% endif %}</span></div>
      <div class="flex flex--row flex--between flex--center-y bg--gray-75 rounded--large p--2 w--full">
        <span class="title title--small">Ali · <span data-ali-card-steps>—</span> steps</span>
        <div class="flex flex--col flex--right gap--xsmall"><span class="label label--small" data-ali-secondary>Awaiting current-day samples</span><span class="label label--small label--gray" data-ali-sync>Apple Health · synced samples</span></div>
      </div>
      <template data-apple-source="ali">{{ private_plugin_536547.merge_variables.health.metrics | json | escape }}</template>
    </div>

    <div class="col--span-5 flex flex--col gap--small outline outline--muted rounded--large p--3">
      <div class="flex flex--row flex--between w--full"><span class="title">Recovery</span><span class="label label--small label--gray">Oura scores / 100</span></div>
      {% render "recovery_person", person: 'stuart', name: 'Stuart' %}
      {% render "recovery_person", person: 'ali', name: 'Ali' %}
      <span class="label label--small label--gray">Apple Health: Stuart + Ali · Oura: both accounts</span>
      <template data-oura-source="stuart">{{ oura_536089.markup_full | escape }}</template>
      <template data-oura-source="ali">{{ oura_536097.markup_full | escape }}</template>
    </div>
  </div>

  <div class="flex flex--col gap--small outline outline--muted rounded--large p--3 w--full">
    <div class="flex flex--row flex--between w--full"><span class="title">Workout consistency</span><span class="label label--small label--gray">Protein Social · 8 weeks · full + partial count</span></div>
    {% if training.status == 'ok' or training.status == 'partial' %}
    <div class="grid grid--cols-12 gap--medium w--full">
      <div class="col--span-6 flex flex--col gap--small">
        <div class="flex flex--row gap--medium flex--center-y w--full">
          <div class="flex flex--col gap--xsmall"><span class="value value--medium">{{ training.this_week }}</span><span class="label label--small label--gray">This week</span></div>
          <div class="flex flex--col gap--xsmall"><span class="value value--medium">{{ training.last_week }}</span><span class="label label--small label--gray">Last week</span></div>
          <div class="flex flex--col gap--xsmall"><span class="value value--medium">{{ training.active_days }}</span><span class="label label--small label--gray">Active days / 8 wk</span></div>
        </div>
        <div class="flex flex--row gap--xsmall flex--center-x w--full">
          <div class="flex flex--col gap--xsmall">{% assign weekdays = 'M,T,W,T,F,S,S' | split: ',' %}{% for letter in weekdays %}<div class="w--4 h--4 flex flex--center-x flex--center-y"><span class="label label--small label--gray">{{ letter }}</span></div>{% endfor %}</div>
          {% for week in training.weeks %}
          <div class="flex flex--col gap--xsmall">
            {% for cell in week.cells %}
            <div class="w--4 h--4 rounded--small {% if cell.full > 0 %}bg--black{% elsif cell.partial > 0 %}bg--gray-50 outline outline--black{% elsif cell.future %}outline outline--muted{% elsif cell.known %}bg--gray-75{% else %}outline outline--muted{% endif %}" title="{{ cell.date }} · {{ cell.count }} logged sessions"></div>
            {% endfor %}
          </div>{% endfor %}
        </div>
      </div>
      <div class="col--span-6 flex flex--col gap--small">
        <span class="label label--small label--gray">WORKOUT DAYS BY WEEK</span>
        {% assign max_week = 1 %}{% for week in training.weeks %}{% if week.count > max_week %}{% assign max_week = week.count %}{% endif %}{% endfor %}
        <svg class="w--full h--40" viewBox="0 0 450 160" role="img" aria-label="Eight weekly totals of workout days including partials">
          {% for week in training.weeks %}{% assign x = forloop.index0 | times: 56 | plus: 28 %}{% assign h = week.count | times: 95.0 | divided_by: max_week %}{% assign y = 120 | minus: h %}
          <rect x="{{ x | minus: 16 }}" y="{{ y }}" width="32" height="{{ h }}" rx="4" fill="{% if forloop.last %}black{% else %}#aaa{% endif %}"/>
          <text x="{{ x }}" y="{{ y | minus: 6 }}" text-anchor="middle" font-size="15">{{ week.count }}</text>
          <text x="{{ x }}" y="144" text-anchor="middle" font-size="11" fill="#666">{{ week.start | date: '%b %-d' }}</text>
          {% endfor %}
        </svg>
      </div>
    </div>
    <span class="label label--small label--gray w--full text--left">Black: complete · Mid-gray outline: partial · Light gray: none · Outline: future / unknown{% if training.status == 'partial' %} · Feed incomplete{% endif %}</span>
    {% else %}<span class="label label--gray">Workout history unavailable · Apple Health and Oura remain independent</span>{% endif %}
  </div>
</div>
<div class="title_bar"><span class="title">Health Detail · Daily movement + consistency</span><span class="instance">Apple Health · Oura · Protein Social · Snapshots · ET</span></div>
